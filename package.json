{
  "name": "load-balanced-routing-demo",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Graphmasters",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Graphmasters/load-balanced-routing-demo.git"
  },
  "homepage": "https://graphmasters.github.io/load-balanced-routing-demo/",
  "description": "Time-slotted vehicle simulation on OpenMapTiles road networks: routes with timestamps, animated on a map. Runs in the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json"
  },
  "dependencies": {
    "maplibre-gl": "6.13.0",
    "omt-router": "1.0.4"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "~6.4.4",
    "vitest": "~5.0.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  }
}
